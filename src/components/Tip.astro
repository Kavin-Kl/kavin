---
// hover word with a little popup: a funny definition (slot) and/or a screenshot (img)
const { word, class: cls = "", img = "", align = "left", wide = false } = Astro.props;
const side = align === "right" ? "right-0" : "left-0";
const arrow = align === "right" ? "right-4" : "left-4";
const width = img || wide ? "w-72" : "w-56";
---
<span class={`relative inline-block group cursor-help ${cls}`}>{word}<span class={`absolute ${side} top-full mt-2 ${width} p-3 bg-zinc-800 text-zinc-300 text-xs font-mono font-normal not-italic normal-case tracking-normal leading-relaxed rounded-xl shadow-xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none z-50`}><span class={`absolute ${arrow} -top-2 w-4 h-4 bg-zinc-800 rotate-45`}></span>{img && <img src={img} alt="" loading="lazy" class="relative w-full rounded-lg mb-2 border border-zinc-700" />}<span class="relative block"><slot /></span></span></span>
