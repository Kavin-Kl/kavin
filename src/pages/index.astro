---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Tip from "../components/Tip.astro";
---

<Layout title="Home">
  <Navbar />

  <h1 id="hero-name" class="text-4xl mb-2 heading-highlight">kavin kl</h1>
